  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action in a view.",
      "html": "<button class=\"ds-btn-primary\">Connect</button>",
      "css": ".ds-btn-primary{height:26px;padding:0 11px;border:1px solid transparent;border-radius:5px;background:#1a6fdb;color:#fff;font:500 12px Montserrat,system-ui,sans-serif}.ds-btn-primary:hover{filter:brightness(1.06)}.ds-btn-primary:focus-visible{outline:2px solid rgba(26,111,219,.45);outline-offset:1px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Cancel, Back and other non-primary actions.",
      "html": "<button class=\"ds-btn\">Cancel</button>",
      "css": ".ds-btn{height:26px;padding:0 11px;border:1px solid #c7c7cf;border-radius:5px;background:#fff;color:#1d1d1f;font:500 12px Montserrat,system-ui,sans-serif;box-shadow:0 1px 1px rgba(0,0,0,.04)}.ds-btn:hover{background:#f4f4f7}.ds-btn:focus-visible{outline:2px solid rgba(26,111,219,.45);outline-offset:1px}"
    },
    {
      "name": "Compose Field",
      "kind": "input",
      "refersTo": "compose-field",
      "description": "Question input at the top of the list; Return asks.",
      "html": "<div class=\"ds-compose\"><textarea rows=\"1\" placeholder=\"Ask a question\u2026\"></textarea></div>",
      "css": ".ds-compose{display:flex;border:1px solid #c7c7cf;border-radius:7px;background:#fff;padding:6px 10px}.ds-compose:focus-within{border-color:#1a6fdb;box-shadow:0 0 0 3px rgba(26,111,219,.12)}.ds-compose textarea{flex:1;border:0;outline:0;resize:none;font:400 13px Montserrat,system-ui,sans-serif}"
    },
    {
      "name": "Four-cell Confidence Mark",
      "kind": "custom",
      "refersTo": "verdict",
      "description": "One cell per candidate query; filled cells agree with the answer. Always paired with words.",
      "html": "<span class=\"ds-cells ds-l4\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i></span>",
      "css": ".ds-cells{display:inline-flex;gap:2px}.ds-cells i{width:10px;height:18px;border-radius:2.5px;border:1px solid currentColor;opacity:.35}.ds-cells i.on{opacity:1;background:currentColor}.ds-l4{color:#0ca30c}"
    },
    {
      "name": "Verdict",
      "kind": "card",
      "refersTo": "verdict",
      "description": "The confidence line at the top of every answer.",
      "html": "<div class=\"ds-verdict\"><span class=\"ds-cells ds-l4\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i></span><div><strong>High confidence</strong><span>4 of 4 candidate queries return this answer.</span></div></div>",
      "css": ".ds-cells{display:inline-flex;gap:2px}.ds-cells i{width:10px;height:18px;border-radius:2.5px;border:1px solid currentColor;opacity:.35}.ds-cells i.on{opacity:1;background:currentColor}.ds-l4{color:#0ca30c}.ds-verdict{display:flex;gap:14px;align-items:center;padding:12px 14px;border-radius:10px;background:#f4f4f7;font:400 12px Montserrat,system-ui,sans-serif;color:#55555c}.ds-verdict strong{display:block;font-size:15px;font-weight:600;color:#1d1d1f}"
    },
    {
      "name": "Question Row",
      "kind": "nav",
      "refersTo": "question-row-selected",
      "description": "A past question in the list, with its confidence and time.",
      "html": "<button class=\"ds-row\"><span class=\"ds-q\">Which 5 countries have the largest population?</span><span class=\"ds-meta\">High \u00b7 2m ago</span></button>",
      "css": ".ds-row{display:grid;gap:4px;width:280px;text-align:left;border:0;border-bottom:1px solid #dcdce2;background:#fbfbfc;padding:10px 14px 10px 16px;font:600 13px Montserrat,system-ui,sans-serif;color:#1d1d1f}.ds-row:hover{background:rgba(0,0,0,.045)}.ds-row:focus-visible{outline:2px solid rgba(26,111,219,.45)}.ds-meta{font:400 12px 'IBM Plex Mono',monospace;color:#6e6e75}"
    },
    {
      "name": "Not-sure Block",
      "kind": "card",
      "refersTo": "verdict",
      "description": "The abstention: header and reading choices instead of a table.",
      "html": "<div class=\"ds-unsure\"><div class=\"ds-uh\"><b>I'm not sure which you mean</b><span>The four candidate queries disagree. Choose the reading you meant.</span></div><div class=\"ds-rd\"><button>A \u00b7 2 of 4 \u00b7 Sana</button><button>B \u00b7 1 of 4 \u00b7 Asha</button></div></div>",
      "css": ".ds-unsure{border:1px solid #dcdce2;border-radius:10px;overflow:hidden;font:400 12px Montserrat,system-ui,sans-serif}.ds-uh{padding:14px 16px;background:rgba(208,59,59,.08);display:grid;gap:2px}.ds-uh b{font-size:15px}.ds-rd{display:grid;grid-template-columns:1fr 1fr}.ds-rd button{border:0;border-top:1px solid #dcdce2;background:#fff;padding:12px;text-align:left;font:600 12px Montserrat,system-ui,sans-serif}.ds-rd button:hover{background:#f4f4f7}"
    }
  ],
  "narrative": {
    "northStar": "The Glass Ledger",
    "overview": "QueryGenie's working is always visible: the SQL behind every table, the four candidate queries behind every answer, and how many agree. The window is each OS's three-pane mail layout, so the frame needs no learning and attention goes to the evidence inside it. Components are native but crisp.",
    "keyCharacteristics": [
      "Three panes: sources, questions, answer",
      "User-chosen answer layout, remembered",
      "Four-cell confidence mark with words",
      "Designed 'not sure' state",
      "Montserrat UI, IBM Plex Mono data",
      "Follows macOS / Windows conventions"
    ],
    "rules": [
      {
        "name": "The Reserved Status Rule",
        "body": "Confidence colours mean confidence only, always with cells or an icon plus words.",
        "section": "colors"
      },
      {
        "name": "The Code Is Mono Rule",
        "body": "IBM Plex Mono only for SQL, data and measurements.",
        "section": "typography"
      },
      {
        "name": "The Floating-Only Shadow Rule",
        "body": "Only menus, dialogs and the setup assistant cast shadows; the window is tonal.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show confidence on every answer in every layout",
      "Do keep SQL one click away and editable",
      "Do follow the host OS for button order, shortcuts, selection and dialogs"
    ],
    "donts": [
      "Don't use confidence colours for anything else",
      "Don't build a chat transcript or a bottom prompt box",
      "Don't hide or soften the 'not sure' state",
      "Don't use emoji or glyphs as icons"
    ]
  }
}