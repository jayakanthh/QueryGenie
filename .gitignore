# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Local virtualenv / caches
.cache/
.huggingface/

# Datasets — reproducible via scripts/download_spider.py (provenance is committed)
data/

# OS / editor
.DS_Store
*.swp

# Generated sample DBs (rebuilt on app startup via build_sample_db.py)
querygenie/sample_data/*.sqlite

# Quantized MLX weights — rebuilt by scripts/convert_mlx.py (large, regenerable)
mlx_models/

# GGUF weights — downloaded from the Hub (large, re-downloadable)
gguf_models/

# Scratch
scratchpad/
tmp/

# Local renders / test caches
docs/_render_tmp*.pdf
.pytest_cache/

# Office lock files
~$*

# Databases uploaded in the app (user data)
querygenie/sample_data/uploads/

# Impeccable local review captures and mocks
.impeccable/review/
.impeccable/mocks/
.impeccable/config.local.json
.impeccable/questions/

# PyInstaller output
/build/
/dist/

